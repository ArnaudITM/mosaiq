  "infos": [
    {
      "titre": "Washington s'impose chez les Giants",
      "texte": "Selon ESPN, les Commanders ont battu les Giants 24-21 jeudi soir après avoir mené 17-7 à la pause. Côté New York, J.J. McCarthy a lancé pour 293 yards et Cam Skattebo a marqué deux touchdowns. Les Giants (5-3-1) restent en tête de la NFC Est.",
      "source": {
        "nom": "ESPN",
        "url": "https://www.espn.com/nfl/scoreboard/_/week/10/year/2026/seasontype/2"
      }
    },
    {
      "titre": "Mahomes s'entraîne normalement",
      "texte": "Selon le rapport de blessures des Chiefs du 13 novembre, Patrick Mahomes (genou, coude droit) a participé pleinement aux trois entraînements de la semaine et n'a pas de statut pour le déplacement à Atlanta. Le running back Kenneth Walker (aine) est incertain.",
      "source": {
        "nom": "Chiefs.com",
        "url": "https://www.chiefs.com/news/week-10-injury-report-chiefs-vs-falcons-2026"
      }
    },
    {
      "titre": "Puka Nacua absent au moins un mois",
      "texte": "Le receveur des Rams (entorse MCL/PCL au genou droit et turf toe) devrait être placé sur la liste des blessés. Côté Seahawks, Sam Darnold est forfait et Drew Lock devrait débuter.",
      "source": {
        "nom": "NFL.com",
        "url": "https://www.nfl.com/news/nfl-power-rankings-week-10-2026-nfl-season"
      }
    },
    {
      "titre": "Lions-Patriots à Munich, Goff sur le rapport médical",
      "texte": "Jared Goff est apparu limité (poitrine) sur le premier rapport de blessures de la semaine, sans indication qu'il puisse manquer le match de dimanche en Allemagne.",
      "source": {
        "nom": "Sports Illustrated",
        "url": "https://www.si.com/nfl/lions/onsi/detroit-lions-jared-goff-surprisingly-lands-week-10-injury-report-2026"
      }
    },
    {
      "titre": "Trade deadline : Cousins aux Vikings, Jacksonville frappe fort",
      "texte": "Minnesota a récupéré Kirk Cousins auprès des Raiders contre un 3e tour 2027, tandis que les Jaguars ont enchaîné trois échanges (dont Jordan Davis et Jessie Bates). Les Colts ont envoyé Keenan Allen aux 49ers et Josh Downs aux Chiefs.",
      "source": {
        "nom": "NFL.com",
        "url": "https://www.nfl.com/news/nfl-power-rankings-week-10-2026-nfl-season"
      }
    }
